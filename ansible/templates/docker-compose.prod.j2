version: '3.8'

services:
  postgres:
    image: postgres:16-alpine
    restart: always
    container_name: {{ compose_project_name }}_postgres
    environment:
      POSTGRES_DB: banking_db
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - {{ deploy_dir }}/postgres-data:/var/lib/postgresql/data
    networks:
      - backend-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    restart: always
    container_name: {{ compose_project_name }}_redis
    command: redis-server --appendonly yes --requirepass ${REDIS_PASSWORD}
    volumes:
      - {{ deploy_dir }}/redis-data:/data
    networks:
      - backend-network
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  bankservice:
    image: {{ registry_url }}/{{ registry_prefix }}:{{ service_version }}
    restart: always
    container_name: {{ compose_project_name }}_bankservice
    ports:
      - "8081:8081"
    environment:
      SPRING_PROFILES_ACTIVE: ${SPRING_PROFILES_ACTIVE}
      DB_URL: ${DB_URL}
      DB_USER: ${DB_USER}
      DB_PASSWORD: ${DB_PASSWORD}
      JWT_SECRET: ${JWT_SECRET}
      JWT_EXPIRATION_MS: ${JWT_EXPIRATION_MS}
      REDIS_HOST: ${REDIS_HOST}
      REDIS_PORT: ${REDIS_PORT}
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      VBANK_API_URL: ${VBANK_API_URL}
      VBANK_API_KEY: ${VBANK_API_KEY}
      TBANK_API_URL: ${TBANK_API_URL}
      TBANK_API_KEY: ${TBANK_API_KEY}
      SBERBANK_API_URL: ${SBERBANK_API_URL}
      SBERBANK_API_KEY: ${SBERBANK_API_KEY}
      LOGGING_LEVEL_ROOT: ${LOGGING_LEVEL_ROOT}
      LOGGING_LEVEL_COM_BANK: ${LOGGING_LEVEL_COM_BANK}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - backend-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    volumes:
      - {{ deploy_dir }}/logs:/app/logs

networks:
  backend-network:
    driver: bridge
