---
version: '3.8'

services:
  # Database для Auth Service
  auth-db:
    image: postgres:16-alpine
    restart: always
    container_name: {{ compose_project_name }}_auth_db
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ vault_postgres_password }}
    volumes:
      - {{ deploy_dir }}/auth-db-data:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Database для Bank Service
  bank-db:
    image: postgres:16-alpine
    restart: always
    container_name: {{ compose_project_name }}_bank_db
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ vault_postgres_password }}
    volumes:
      - {{ deploy_dir }}/bank-db-data:/var/lib/postgresql/data
    ports:
      - "5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Database для Radar Service
  radar-db:
    image: postgres:16-alpine
    restart: always
    container_name: {{ compose_project_name }}_radar_db
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ vault_postgres_password }}
    volumes:
      - {{ deploy_dir }}/radar-db-data:/var/lib/postgresql/data
    ports:
      - "5434:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis для caching
  redis:
    image: {{ registry_url }}/{{ registry_prefix }}/infra-redis:latest
    restart: always
    container_name: {{ compose_project_name }}_redis
    command: redis-server --appendonly yes
    volumes:
      - {{ deploy_dir }}/redis-data:/data
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  # Auth Service
  auth:
    image: {{ registry_url }}/{{ registry_prefix }}/authService:{{ authService_version }}
    restart: always
    container_name: {{ compose_project_name }}_auth
    ports:
      - "{{ auth_port }}:8080"
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ vault_postgres_password }}
      AUTH_DB_CONTAINER_NAME: auth-db
      DB_PORT: 5432
      JWT_SECRET: {{ vault_jwt_secret }}
      SPRING_PROFILES_ACTIVE: {{ spring_profiles_active }}
      LOGGING_LEVEL_ROOT: {{ logging_level_root }}
    depends_on:
      auth-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    volumes:
      - {{ deploy_dir }}/logs/auth:/app/logs

  # Bank Service
  bank:
    image: {{ registry_url }}/{{ registry_prefix }}/bankService:{{ bankService_version }}
    restart: always
    container_name: {{ compose_project_name }}_bank
    ports:
      - "{{ bank_port }}:8081"
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ vault_postgres_password }}
      BANK_DB_CONTAINER_NAME: bank-db
      DB_PORT: 5433
      JWT_SECRET: {{ vault_jwt_secret }}
      REDIS_HOST: {{ redis_host }}
      REDIS_PORT: {{ redis_port }}
      AUTH_CONTAINER_URL: {{ auth_url }}
      RADAR_CONTAINER_URL: {{ radar_url }}
      SPRING_PROFILES_ACTIVE: {{ spring_profiles_active }}
      LOGGING_LEVEL_ROOT: {{ logging_level_root }}
    depends_on:
      bank-db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    volumes:
      - {{ deploy_dir }}/logs/bank:/app/logs

  # Radar Service
  radar:
    image: {{ registry_url }}/{{ registry_prefix }}/radarService:{{ radarService_version }}
    restart: always
    container_name: {{ compose_project_name }}_radar
    ports:
      - "{{ radar_port }}:8082"
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ vault_postgres_password }}
      RADAR_DB_CONTAINER_NAME: radar-db
      DB_PORT: 5434
      JWT_SECRET: {{ vault_jwt_secret }}
      REDIS_HOST: {{ redis_host }}
      REDIS_PORT: {{ redis_port }}
      AUTH_CONTAINER_URL: {{ auth_url }}
      BANK_CONTAINER_URL: {{ bank_url }}
      SPRING_PROFILES_ACTIVE: {{ spring_profiles_active }}
      LOGGING_LEVEL_ROOT: {{ logging_level_root }}
    depends_on:
      radar-db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8082/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    volumes:
      - {{ deploy_dir }}/logs/radar:/app/logs

  # Nginx
  nginx:
    image: {{ registry_url }}/{{ registry_prefix }}/infra-nginx:latest
    restart: always
    container_name: {{ compose_project_name }}_nginx
    ports:
      - "80:80"
      - "443:443"
    depends_on:
      - auth
      - bank
      - radar

  # Prometheus
  prometheus:
    image: {{ registry_url }}/{{ registry_prefix }}/infra-prometheus:latest
    restart: always
    container_name: {{ compose_project_name }}_prometheus
    ports:
      - "9090:9090"
    volumes:
      - {{ deploy_dir }}/prometheus-data:/prometheus

volumes:
  auth-db-data:
  bank-db-data:
  radar-db-data:
  redis-data:
  prometheus-data:
